# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Admin: required by every authenticated API route.
# Configure these exact names in Vercel for Production, Preview and Development.
FIREBASE_PROJECT_ID="exu-responde"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@example.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"

# Mercado Pago: required to create payment preferences and confirm webhooks.
MERCADO_PAGO_ACCESS_TOKEN="YOUR_MERCADO_PAGO_ACCESS_TOKEN"

# Public application URL.
APP_URL="https://exu-responde.vercel.app"